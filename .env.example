# ---------------------------------------------------------------------------
# Contact form email delivery (Resend - https://resend.com)
#
# LOCAL SETUP
#   1. Copy this file to .env.local  (git-ignored, never commit it)
#   2. Create an API key at https://resend.com/api-keys and paste it below
#   3. Restart the dev server
#
# Without RESEND_API_KEY the form still renders and validates, but submitting
# returns a friendly "Email is not configured yet. Please call us instead."
# rather than erroring. That is intentional.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Where enquiries are delivered.
# Falls back to lib/site.ts -> site.email (info@atelierhomes.com.au), which
# does not exist as a mailbox yet. Set this to a real inbox.
CONTACT_TO=

# Sender shown on enquiry emails.
# Until atelierhomes.com.au is verified in Resend, leave this unset and the
# route falls back to Resend's test sender (onboarding@resend.dev), which can
# only deliver to the address that owns the Resend account.
# Once the domain is verified, set:
#   CONTACT_FROM="Atelier Homes Website <noreply@atelierhomes.com.au>"
CONTACT_FROM=
