# Contact form email delivery (Resend — https://resend.com)
# Create an API key in the Resend dashboard and add it here / in Vercel env vars.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to info@atelierhomes.com.au (placeholder).
CONTACT_TO=

# Optional. Sender shown on contact emails. Must use a domain verified in Resend.
# Falls back to Resend's test sender (onboarding@resend.dev) if unset.
CONTACT_FROM="Atelier Homes Website <noreply@atelierhomes.com.au>"
